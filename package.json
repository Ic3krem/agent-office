{
  "name": "agent-office",
  "version": "2.0.0-beta.5",
  "description": "A pixel office for your Claude Code agents: Tiro the manager, specialists, approvals, reports and memory.",
  "main": "desktop/main.mjs",
  "scripts": {
    "start": "electron .",
    "perf:town": "electron perf/town-perf.cjs",
    "art": "node art/build.mjs",
    "test": "node --test --test-concurrency=4 office-nav.test.mjs company.test.mjs role-catalog.test.mjs roster-live.test.mjs agent-home.test.mjs transcript.test.mjs usage.test.mjs reports.test.mjs island.test.mjs office-motion.test.mjs perf-sources.test.mjs scheduler.test.mjs scheduler-job.test.mjs repo.test.mjs perf.test.mjs ports.test.mjs security.test.mjs parity.test.mjs hardening.test.mjs bridge-register.test.mjs notch.test.mjs share-ready.test.mjs guard.test.mjs guard-wiring.test.mjs guard-review.test.mjs nowplaying.test.mjs lyrics.test.mjs updater.test.mjs desktop-port.test.mjs updater-signed.test.mjs world-parity.test.mjs world-path.test.mjs world-model.test.mjs world-store.test.mjs world-edit.test.mjs world-player.test.mjs world-templates.test.mjs goal-pace.test.mjs wardrobe.test.mjs karinderya.test.mjs party.test.mjs release-hardening.test.mjs town-static.test.mjs town-map.test.mjs agent-travel.test.mjs art-output.test.mjs town-render.test.mjs office-sprites-path.test.mjs graphics.test.mjs town-ambient.test.mjs town-render-2d.test.mjs office-graphics.test.mjs tmp-sweep.test.mjs party-host.test.mjs town-animals.test.mjs town-scenery.test.mjs external-agents.test.mjs external-run.test.mjs external-delegate.test.mjs external-settings.test.mjs cli-auth.test.mjs claude-key.test.mjs party-music.test.mjs music.test.mjs manor.test.mjs",
    "dist": "electron-builder"
  },
  "author": {
    "name": "Ic3krem",
    "email": "Ic3krem@users.noreply.github.com"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.301",
    "exceljs": "4.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "electron": "43.8.7",
    "electron-builder": "26.15.3"
  },
  "productName": "TiroAgents",
  "build": {
    "appId": "io.github.ic3krem.tiroagents",
    "productName": "TiroAgents",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "files": [
      "server.mjs",
      "transcript.mjs",
      "company.mjs",
      "agent-home.mjs",
      "auth.mjs",
      "ports.mjs",
      "prefs-file.mjs",
      "permissions.mjs",
      "guard/*.mjs",
      "redact.mjs",
      "external-agents.mjs",
      "external-run.mjs",
      "external-delegate.mjs",
      "external-settings.mjs",
      "cli-auth.mjs",
      "claude-key.mjs",
      "music.mjs",
      "retention.mjs",
      "usage.mjs",
      "perf.mjs",
      "reports.mjs",
      "vault.mjs",
      "scheduler.mjs",
      "scheduler-job.mjs",
      "office.mjs",
      "world-store.mjs",
      "world-vm.mjs",
      "party-client.mjs",
      "party/protocol.mjs",
      "party/server.mjs",
      "party/games.mjs",
      "party-host.mjs",
      "public/**",
      "desktop/**",
      "package.json",
      "LICENSE",
      "NOTICE",
      "THIRD_PARTY_NOTICES.md",
      "node_modules/**",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*/**",
      "!node_modules/exceljs/dist/**",
      "!node_modules/**/*.{map,d.ts,d.cts,d.mts}"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Ic3krem",
        "repo": "agent-office",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "desktop/icon.png",
      "artifactName": "TiroAgents-Setup-${version}.${ext}"
    },
    "nsis": {
      "license": "LICENSE.txt",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "TiroAgents",
      "runAfterFinish": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "desktop/icon.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "TiroAgents-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "desktop/icon.png",
      "category": "Development",
      "artifactName": "TiroAgents-${version}-${arch}.${ext}",
      "maintainer": "Ic3krem <Ic3krem@users.noreply.github.com>"
    },
    "asarUnpack": [
      "desktop/nowplaying.ps1"
    ],
    "electronFuses": {
      "runAsNode": true,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    }
  },
  "homepage": "https://github.com/Ic3krem/agent-office",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ic3krem/agent-office.git"
  },
  "license": "Apache-2.0",
  "keywords": [
    "claude",
    "claude-code",
    "ai-agents",
    "agent-sdk",
    "electron",
    "pixel-art",
    "obsidian",
    "desktop-app"
  ]
}
